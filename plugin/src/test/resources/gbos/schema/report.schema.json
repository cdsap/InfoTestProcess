{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build Observability Report",
  "type": "object",
  "required": ["schemaVersion", "resource", "observations"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "resource": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "observation.schema.json"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
